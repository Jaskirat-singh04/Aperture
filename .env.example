# Copy this file to .env and adjust as needed. No real secrets belong here.
APERTURE_ENVIRONMENT=local

# Database (Postgres with pgvector, started by docker compose)
APERTURE_DB_HOST=localhost
APERTURE_DB_PORT=5432
APERTURE_DB_NAME=aperture
APERTURE_DB_USER=aperture
APERTURE_DB_PASSWORD=aperture

# LLM and embedding provider, routed through LiteLLM.
# Default points at a local Ollama instance. Swap for a hosted provider by
# changing the model identifier and api_key, no code change needed.
APERTURE_LLM_MODEL=ollama/llama3
APERTURE_LLM_EMBEDDING_MODEL=ollama/nomic-embed-text
APERTURE_LLM_API_BASE=http://localhost:11434
APERTURE_LLM_API_KEY=
APERTURE_LLM_EMBEDDING_DIMENSION=768

# OIDC (Dex, the local identity provider)
APERTURE_OIDC_ISSUER=http://localhost:5556/dex
APERTURE_OIDC_AUDIENCE=aperture-api
APERTURE_OIDC_JWKS_URL=http://localhost:5556/dex/keys

# OpenFGA (document-level authorization)
APERTURE_OPENFGA_API_URL=http://localhost:8080
APERTURE_OPENFGA_STORE_ID=
APERTURE_OPENFGA_AUTHORIZATION_MODEL_ID=

# OpenTelemetry
APERTURE_OTEL_OTLP_ENDPOINT=http://localhost:4317
APERTURE_OTEL_SERVICE_NAME=aperture-api
APERTURE_OTEL_ENABLED=true
